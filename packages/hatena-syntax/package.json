{
  "name": "@thorikiri/hatena-syntax",
  "version": "0.1.0",
  "description": "はてな記法パーサーおよびコンバーター",
  "license": "MIT",
  "author": "@thorikiri",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thorikiri/hatena-tools.git",
    "directory": "packages/hatena-syntax"
  },
  "homepage": "https://github.com/thorikiri/hatena-tools/tree/main/packages/hatena-syntax#readme",
  "bugs": {
    "url": "https://github.com/thorikiri/hatena-tools/issues"
  },
  "keywords": [
    "hatena",
    "hatena-blog",
    "hatena-syntax",
    "hatena-fotolife",
    "markdown",
    "html",
    "parser",
    "ast",
    "typescript"
  ],
  "type": "module",
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0"
  },
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup src/index.ts --format esm,cjs --dts --clean",
    "typecheck": "tsc --noEmit"
  },
  "publishConfig": {
    "access": "public"
  }
}
